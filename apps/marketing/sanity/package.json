{
  "name": "specforge-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Sanity Studio for the SpecForge marketing zone (issue #18, Phase 3). Standalone editor surface — deployed separately (sanity deploy), never embedded on the public marketing origin.",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/vision": "^6.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanity": "^6.5.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": "0.6.0",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@<3.15.0": "3.15.0",
      "prismjs@<1.30.0": "1.30.0",
      "smol-toml@<1.6.1": "1.6.1",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
