{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/dashboard", "destination": "https://thought2build.vercel.app/dashboard" },
    { "source": "/dashboard/:path*", "destination": "https://thought2build.vercel.app/dashboard/:path*" },
    { "source": "/workspace/:path*", "destination": "https://thought2build.vercel.app/workspace/:path*" },
    { "source": "/settings", "destination": "https://thought2build.vercel.app/settings" },
    { "source": "/settings/:path*", "destination": "https://thought2build.vercel.app/settings/:path*" },
    { "source": "/billing", "destination": "https://thought2build.vercel.app/billing" },
    { "source": "/billing/:path*", "destination": "https://thought2build.vercel.app/billing/:path*" },
    { "source": "/auth/:path*", "destination": "https://thought2build.vercel.app/auth/:path*" },
    { "source": "/p/:path*", "destination": "https://thought2build.vercel.app/p/:path*" },
    { "source": "/sb/:path*", "destination": "https://thought2build.vercel.app/sb/:path*" },
    { "source": "/github", "destination": "https://thought2build.vercel.app/github" },
    { "source": "/github/:path*", "destination": "https://thought2build.vercel.app/github/:path*" },
    { "source": "/storyboards/:path*", "destination": "https://thought2build.vercel.app/storyboards/:path*" },
    { "source": "/legal/terms", "destination": "https://thought2build.vercel.app/legal/terms" },
    { "source": "/legal/privacy", "destination": "https://thought2build.vercel.app/legal/privacy" },
    { "source": "/assets/:path*", "destination": "https://thought2build.vercel.app/assets/:path*" }
  ]
}
