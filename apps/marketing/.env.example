# Marketing zone (Astro) environment.
# Canonical/OG/sitemap base. HTTPS apex in production (enforced in Phase 7).
PUBLIC_SITE_URL=https://specforge.app
# Backend origin that owns the OAuth start endpoint. The "Sign in with Google"
# CTA links to ${PUBLIC_API_URL}/auth/google.
PUBLIC_API_URL=https://api.specforge.app

# Sanity content source (issue #18, Phase 3). projectId + dataset are PUBLIC
# values; a read token is NOT needed (published content on a public dataset is
# read tokenlessly at build time) and must NEVER be PUBLIC_-prefixed. Leave
# PUBLIC_SANITY_PROJECT_ID blank to build without Sanity — the fetch layer
# degrades to empty content and the build stays green.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-10-01

# Measurement (issue #18, Phase 5). All optional and OFF by default — the zone
# ships ZERO analytics JS until PUBLIC_ANALYTICS_ENABLED is exactly "true"
# (real wiring switches on in Phase 7). Vendor is Vercel Web Analytics, whose
# script is served first-party from /_vercel/insights/* (same-origin, CSP-clean
# — no third-party host to allowlist). It also needs the @vercel/analytics
# integration enabled on the Vercel project.
PUBLIC_ANALYTICS_ENABLED=false
# Google Search Console verification token — the `content` value of the
# <meta name="google-site-verification"> tag. Independent of analytics: the tag
# renders whenever this is set. Leave blank to omit it (e.g. if verifying by DNS).
PUBLIC_GSC_VERIFICATION=
