---
// Templates hub (issue #18, Phase 4). Indexable surface for the "PRD / spec /
// plan template" cluster. Lists every template page; cards link the detail
// routes.
import ContentLayout from "../../layouts/ContentLayout.astro"
import HubCrossLinks from "../../components/content/HubCrossLinks.astro"
import { getTemplatePages, templatePath } from "../../lib/sanity"
import { breadcrumbListSchema, type BreadcrumbItem } from "../../lib/seo"

const docs = await getTemplatePages()

const title = "Thought2Build Templates — PRD, Spec & Build-Plan Starters"
const description =
  "Starter templates for PRDs, product specs, and engineering plans — generate a structured first draft with Thought2Build and adapt it to your idea instead of starting from a blank page."

const crumbs: BreadcrumbItem[] = [
  { name: "Home", path: "/" },
  { name: "Templates", path: "/templates" },
]
const jsonLd = breadcrumbListSchema(crumbs)
---

<ContentLayout title={title} description={description} path="/templates" activeHub="/templates" jsonLd={jsonLd}>
  <main class="content-main is-wide">
    <header class="content-header hub-intro">
      <span class="content-kicker">Templates</span>
      <h1>PRD, spec, and build-plan templates you can generate and adapt</h1>
      <p class="content-lede">
        Don't start from a blank page. Each template shows the structure Thought2Build
        generates — requirements, architecture, validation, and tasks — so you can
        see the shape of a strong brief and produce your own from a rough idea.
      </p>
    </header>

    <section class="hub-orientation">
      <p>
        A blank document is the most expensive part of writing a spec. Not because the
        writing itself is hard, but because staring at an empty page forces you to
        invent structure and content at the same time — decide what sections a good PRD
        even has while also trying to describe your actual product. Templates remove
        one of those two problems. You still have to know what you're building; you no
        longer have to guess what "done" looks like as a document.
      </p>
      <h2>What a good spec template actually contains</h2>
      <p>
        A template that's worth using does more than provide headings. It should show
        you the shape of good requirements (specific, testable, not "the system should
        be fast"), a place for explicit constraints and non-goals, an architecture
        section that forces a real decision instead of a paragraph of hedging, a
        validation or acceptance-test section that defines "done" in a way a reviewer
        can check, and a task breakdown granular enough to hand to one person — or one
        coding-agent run — at a time.
      </p>
      <p>
        Every template on this hub is the structure Thought2Build's own generation
        pipeline produces: a SPEC with requirements and constraints, a PLAN with
        architecture and sequencing, a HARNESS of acceptance criteria, and a TASKS
        breakdown that traces back to both. You can read a template here to see what a
        strong first draft looks like for a given kind of project — a SaaS PRD, an API
        spec, an internal tool brief — and then generate and adapt your own from a
        one-line idea instead of copy-pasting a static doc and hoping it fits.
      </p>
      <p>
        These are starting points, not straitjackets. The point of seeing the shape of a
        strong spec up front is that you can tell, fast, which sections apply to your
        project and which don't — which is a much better position than discovering a
        missing acceptance-criteria section three weeks into a build.
      </p>
    </section>

    {docs.length > 0 ? (
      <div class="hub-grid">
        {docs.map((doc) => (
          <a class="hub-card" href={templatePath(doc.slug)}>
            <h2>{doc.heading}</h2>
            <p>{doc.seo.description}</p>
            <span class="hub-card-more">View template &rarr;</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="hub-empty">New templates are on the way. Check back soon.</p>
    )}

    <HubCrossLinks current="/templates" />
  </main>
</ContentLayout>
