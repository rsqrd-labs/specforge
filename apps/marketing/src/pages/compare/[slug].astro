---
// Comparison detail page (issue #18, Phase 4). Backed by `seoPage` documents
// with section == "comparison" — these target high-intent "X vs Y" / "best tool
// for specs/PRDs" queries and lead with the comparison table. BreadcrumbList
// always; FAQPage when FAQs exist.
import ContentLayout from "../../layouts/ContentLayout.astro"
import SeoPageArticle from "../../components/content/SeoPageArticle.astro"
import { getSeoPages, seoPagePath } from "../../lib/sanity"
import type { SeoPageDoc } from "../../lib/sanity"
import { breadcrumbListSchema, faqPageSchema, type BreadcrumbItem } from "../../lib/seo"

export async function getStaticPaths() {
  const docs = await getSeoPages("comparison")
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))
}

interface Props {
  doc: SeoPageDoc
}

const { doc } = Astro.props
const path = seoPagePath("comparison", doc.slug)

const crumbs: BreadcrumbItem[] = [
  { name: "Home", path: "/" },
  { name: "Comparisons", path: "/compare" },
  { name: doc.heading, path },
]

const jsonLd: Record<string, unknown>[] = [breadcrumbListSchema(crumbs)]
if (doc.faqs && doc.faqs.length) jsonLd.push(faqPageSchema(doc.faqs))
---

<ContentLayout
  title={doc.seo.title}
  description={doc.seo.description}
  path={path}
  image={doc.seo.ogImage}
  activeHub="/compare"
  jsonLd={jsonLd}
>
  <SeoPageArticle doc={doc} kicker="Comparison" crumbs={crumbs} />
</ContentLayout>
