---
// Emits a JSON-LD <script> for structured data. Pass any schema.org object (or
// an array of objects) via `schema`. Phase 2 layers in per-type shapes
// (Organization, SoftwareApplication, FAQPage, BreadcrumbList, Article) and
// validates them in tests; this component is the single rendering primitive.
interface Props {
  schema: Record<string, unknown> | Record<string, unknown>[]
}

const { schema } = Astro.props
const json = JSON.stringify(schema)
---

<script type="application/ld+json" is:inline set:html={json} />
