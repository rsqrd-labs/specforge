---
// Reusable head-metadata component: title, description, canonical, Open Graph,
// Twitter card, and robots directives. Driven entirely by props so every
// indexable route declares unique, complete metadata (issue #18, Phase 2).
//
// `title` and `description` are REQUIRED with no default — they must be unique
// per route and the Phase 6 QA fails on missing/duplicate values. Only the safe
// fields (image, locale, ogType, robots) default. Article time/author and the
// optional Twitter handle support the guide pages that land in Phase 3/4.
import { SITE_NAME, absoluteUrl } from "../consts"
import { DEFAULT_OG_IMAGE, OG_LOCALE, TWITTER_CARD } from "../lib/seo"

interface Props {
  title: string
  description: string
  /** Site-relative path (e.g. "/", "/guides/foo"). Resolved to an absolute canonical. */
  path?: string
  /** Site-relative or absolute OG/Twitter image. */
  image?: string
  /** Accessible/social alt text for the share image. Defaults to the title. */
  imageAlt?: string
  /** OpenGraph type — "website" for hubs, "article" for guides. */
  ogType?: "website" | "article"
  /** Robots directive. Marketing pages are indexable by default. */
  robots?: string
  /** ISO 8601; emitted as article:published_time when ogType="article". */
  publishedTime?: string
  /** ISO 8601; emitted as article:modified_time when ogType="article". */
  modifiedTime?: string
  /** Optional @handle for twitter:site / twitter:creator. */
  twitterSite?: string
}

const {
  title,
  description,
  path = "/",
  image = DEFAULT_OG_IMAGE,
  imageAlt = title,
  ogType = "website",
  robots = "index, follow",
  publishedTime,
  modifiedTime,
  twitterSite,
} = Astro.props

const canonical = absoluteUrl(path)
const imageUrl = absoluteUrl(image)
const isArticle = ogType === "article"
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={OG_LOCALE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{isArticle && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{isArticle && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

<!-- Twitter -->
<meta name="twitter:card" content={TWITTER_CARD} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterSite && <meta name="twitter:creator" content={twitterSite} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
