<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {# Trusted, codebase-owned print deck (T-255). The LLM never contributes
       markup: every dynamic value below is structured, already-sanitised text
       and is HTML-escaped by Jinja autoescape. Every colour is a validated
       #RRGGBB hex (re-checked in the renderer), so inlining it into a style
       attribute or a CSS custom property cannot break out of the colour context.
       One designed slide per page; print-native (no backdrop-filter, blend modes
       or background-clip:text — none of which survive WeasyPrint). No <script>,
       no remote assets, no external fonts — a self-contained offline package. #}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} — SpecForge Storyboard</title>
    <style>
      @page {
        size: A4 landscape;
        margin: 0;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Helvetica", "Arial", sans-serif;
        color: #11152b;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* Each .page is exactly one printed slide. WeasyPrint's flexbox does not
         reliably grow/center, so the page is a fixed-size positioning canvas and
         every region is absolutely placed inside it — no flex grow, no content
         flow that could overflow and split one slide across two printed pages. */
      .page {
        position: relative;
        width: 297mm;
        height: 210mm;
        overflow: hidden;
        page-break-before: always;
      }
      .page:first-child { page-break-before: avoid; }

      .page__foot {
        position: absolute;
        left: 24mm;
        right: 24mm;
        bottom: 9mm;
        display: flex;
        justify-content: space-between;
        font-size: 8pt;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 0.02em;
      }

      /* ---- Cover ---------------------------------------------------------- */
      .page--cover {
        padding: 0;
        background: linear-gradient(135deg, {{ cover_accent }}, {{ cover_accent_2 }});
        color: #ffffff;
      }
      .cover-inner {
        height: 100%;
        padding: 34mm 30mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .cover-kicker {
        display: inline-flex;
        align-items: center;
        gap: 4mm;
        font-size: 11pt;
        font-weight: 800;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        opacity: 0.85;
        margin-bottom: 8mm;
      }
      .cover-kicker .squirrel-brand-mark {
        width: 18mm;
        height: 18mm;
        flex: 0 0 auto;
      }
      .cover-title {
        font-size: 54pt;
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -0.01em;
        margin: 0;
      }
      .cover-motif {
        margin-top: 8mm;
        font-size: 15pt;
        line-height: 1.4;
        max-width: 200mm;
        opacity: 0.94;
      }
      .cover-swatches { margin-top: 16mm; font-size: 0; }
      .cover-swatches span {
        display: inline-block;
        width: 18mm;
        height: 3mm;
        margin-right: 3mm;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.88);
      }
      .cover-brand {
        position: absolute;
        left: 30mm;
        bottom: 16mm;
        display: inline-flex;
        align-items: center;
        gap: 2mm;
        font-size: 9pt;
        font-weight: 700;
        letter-spacing: 0.04em;
        opacity: 0.85;
      }
      .cover-brand .squirrel-brand-mark {
        width: 8mm;
        height: 8mm;
        flex: 0 0 auto;
      }

      /* ---- Slide page ----------------------------------------------------- */
      .page--slide {
        /* A pale, per-act themed wash (white veil over the act gradient) keeps
           the page airy while still carrying the slide's colour. */
        background:
          linear-gradient(rgba(255, 255, 255, 0.93), rgba(255, 255, 255, 0.93)),
          linear-gradient(135deg, var(--a), var(--a2));
      }
      .page--slide::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 8mm;
        background: linear-gradient(180deg, var(--a), var(--a2));
      }
      .kicker {
        position: absolute;
        top: 15mm;
        left: 24mm;
        right: 24mm;
        font-size: 9.5pt;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
      }
      .kicker .kicker__act { color: #94a3b8; }
      .slide-body {
        position: absolute;
        top: 40mm;
        left: 24mm;
        right: 24mm;
        bottom: 20mm;
        display: grid;
        grid-template-columns: 1.08fr 0.92fr;
        gap: 16mm;
        align-items: center;
      }
      .headline {
        margin: 0;
        font-size: 30pt;
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.01em;
        color: #11152b;
      }
      .headline-rule {
        width: 26mm;
        height: 1.5mm;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--a), var(--a2));
        margin: 6mm 0;
      }
      .visible-text {
        margin: 0;
        font-size: 13.5pt;
        line-height: 1.45;
        color: #475569;
        max-width: 120mm;
      }
      .chips { margin-top: 8mm; }
      .chip {
        display: inline-block;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        padding: 1mm 3mm;
        margin: 0 1.5mm 1.5mm 0;
        font-size: 8.5pt;
        font-weight: 800;
        color: #64748b;
      }

      /* Visual card — translucent panel with a gradient top strip + accent rail. */
      .vcard {
        position: relative;
        border: 1px solid var(--a);
        border-radius: 6mm;
        background: rgba(255, 255, 255, 0.72);
        padding: 10mm 11mm;
        overflow: hidden;
        min-height: 64mm;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .vcard::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1.6mm;
        background: linear-gradient(90deg, var(--a), var(--a2));
      }
      .vcard__label {
        font-size: 9pt;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: 6mm;
      }
      .vcard__metric {
        font-size: 34pt;
        font-weight: 800;
        line-height: 1.04;
        color: var(--ink);
        letter-spacing: -0.02em;
      }
      .vcard__metric-label {
        display: inline-block;
        margin-top: 5mm;
        border: 1px solid var(--a);
        border-radius: 999px;
        padding: 1.5mm 4mm;
        font-size: 9.5pt;
        font-weight: 700;
        color: var(--ink);
      }
      .vcard__points { margin: 0; padding: 0; list-style: none; }
      .vcard__points li {
        position: relative;
        padding: 2.5mm 0 2.5mm 8mm;
        font-size: 12pt;
        font-weight: 600;
        color: #1f2937;
        line-height: 1.3;
      }
      .vcard__points li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4.6mm;
        width: 3mm;
        height: 3mm;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--a), var(--a2));
      }
      /* Block bars (not flex) so WeasyPrint sizes them reliably. */
      .vcard__motif span {
        display: block;
        width: 100%;
        height: 9mm;
        margin-bottom: 4mm;
        border-radius: 2.5mm;
      }
      .vcard__motif span:last-child { margin-bottom: 0; }

      /* ---- Architecture slide -------------------------------------------- */
      /* The Technical Architecture slide drops the two-column body: copy sits in a
         fixed-height band on top, the topology graph fills the full width below —
         the static (print) analogue of the live deck's animated SVG topology. The
         fixed copy band guarantees the diagram can never be pushed into overlap. */
      .page--arch-slide .headline { font-size: 22pt; }
      .arch-slide-copy {
        position: absolute;
        top: 28mm;
        left: 24mm;
        right: 24mm;
        height: 46mm;
        overflow: hidden;
      }
      /* The topology SVG is sized to the band so WeasyPrint lays it out reliably;
         preserveAspectRatio centres the diagram within it. Every shape colour is a
         validated #RRGGBB hex inlined as an SVG presentation attribute — no
         gradients (unreliable in WeasyPrint), no url()/filters, no remote refs. */
      .arch-topology {
        position: absolute;
        top: 78mm;
        left: 24mm;
        width: 249mm;
        height: 119mm;
      }
    </style>
  </head>
  <body>
    {# ---- Cover ---- #}
    <section class="page page--cover">
      <div class="cover-inner">
        <div class="cover-kicker">
          {% include "_brand_squirrel.svg.j2" %}
          <span>SpecForge Launch Keynote</span>
        </div>
        <h1 class="cover-title">{{ title }}</h1>
        {% if motif %}<div class="cover-motif">{{ motif }}</div>{% endif %}
        <div class="cover-swatches">
          {% for colour in palette %}
          <span style="background: {{ colour }};"></span>
          {% endfor %}
        </div>
      </div>
      <div class="cover-brand">
        {% include "_brand_squirrel.svg.j2" %}
        <span>Generated by SpecForge · {{ generated_at }}</span>
      </div>
    </section>

    {# ---- One designed slide per page ---- #}
    {% for page in pages %}
    {% if page.architecture %}
    {# Architecture slide: the topology graph *is* this slide's visual (mirrors the
       live deck's static-complete SVG), so copy sits on top and the node/edge
       diagram spans the full width below — no separate architecture page. #}
    {% set a = page.architecture %}
    <section class="page page--slide page--arch-slide" style="--a: {{ page.accent }}; --a2: {{ page.accent_2 }}; --ink: {{ page.ink }};">
      <div class="kicker">
        <span class="kicker__act">Act {{ page.act_no }}</span> · {{ page.act_title }}
      </div>
      <div class="arch-slide-copy">
        <h2 class="headline">{{ page.headline }}</h2>
        <div class="headline-rule"></div>
        {% if page.visible_text %}<p class="visible-text">{{ page.visible_text }}</p>{% endif %}
        {% if page.sources %}
        <div class="chips">
          {% for src in page.sources %}<span class="chip">{{ src }}</span>{% endfor %}
        </div>
        {% endif %}
      </div>
      {# font-family is set as an inherited SVG attribute (not a CSS rule) so it
         applies even where WeasyPrint does not cascade HTML CSS into inline SVG. #}
      <svg class="arch-topology" viewBox="0 0 {{ a.view_w }} {{ a.view_h }}" preserveAspectRatio="xMidYMid meet" font-family="Helvetica, Arial, sans-serif">
        {# Recovery backplane (lowest layer). #}
        <rect x="{{ a.recovery.x }}" y="{{ a.recovery.y }}" width="{{ a.recovery.w }}" height="{{ a.recovery.h }}" rx="22" fill="{{ a.recovery.fill }}" fill-opacity="0.09" stroke="{{ a.recovery.stroke }}" stroke-opacity="0.34" stroke-width="1.25" />
        <text x="{{ a.recovery.label_x }}" y="{{ a.recovery.label_y }}" fill="{{ a.recovery.label_fill }}" font-size="13" font-weight="700">{{ a.recovery.label }}</text>
        {# Trust boundary (dashed outline). #}
        <rect x="{{ a.trust.x }}" y="{{ a.trust.y }}" width="{{ a.trust.w }}" height="{{ a.trust.h }}" rx="20" fill="none" stroke="{{ a.trust.stroke }}" stroke-opacity="0.6" stroke-width="1.75" stroke-dasharray="8 7" />
        <text x="{{ a.trust.label_x }}" y="{{ a.trust.label_y }}" fill="{{ a.trust.label_fill }}" font-size="13" font-weight="700">{{ a.trust.label }}</text>
        {# Directed edges with arrowheads. #}
        {% for edge in a.edges %}
        <path d="{{ edge.d }}" fill="none" stroke="{{ edge.stroke }}" stroke-opacity="0.7" stroke-width="2.5" stroke-linecap="round" />
        <polygon points="{{ edge.arrow }}" fill="{{ edge.arrow_fill }}" />
        {% endfor %}
        {# Box nodes. #}
        {% for node in a.nodes %}
        <rect x="{{ node.x }}" y="{{ node.y }}" width="{{ node.w }}" height="{{ node.h }}" rx="14" fill="#ffffff" fill-opacity="0.82" stroke="{{ node.accent }}" stroke-width="1.25" />
        <rect x="{{ node.x }}" y="{{ node.y }}" width="4" height="{{ node.h }}" fill="{{ node.accent }}" />
        <text x="{{ node.text_x }}" y="{{ node.kind_y }}" fill="{{ node.ink }}" font-size="9.5" font-weight="700">{{ node.kind|upper }}</text>
        {% for line in node.label_lines %}
        <text x="{{ node.text_x }}" y="{{ node.label_y0 + loop.index0 * 16 }}" fill="#11152b" font-size="13" font-weight="700">{{ line }}</text>
        {% endfor %}
        {% endfor %}
        {# Unknown / group kinds: unconnected annotations. #}
        {% for extra in a.extras %}
        <rect x="{{ extra.x }}" y="{{ extra.y }}" width="{{ extra.w }}" height="{{ extra.h }}" rx="10" fill="#ffffff" fill-opacity="0.7" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5 4" />
        <text x="{{ extra.x + 12 }}" y="{{ extra.y + 27 }}" fill="#475569" font-size="11" font-weight="700">{{ extra.label }}</text>
        {% endfor %}
      </svg>
      <div class="page__foot">
        <span>{{ title }}</span>
        <span>{{ page.slide_no }} / {{ total_slides }}</span>
      </div>
    </section>
    {% else %}
    <section class="page page--slide" style="--a: {{ page.accent }}; --a2: {{ page.accent_2 }}; --ink: {{ page.ink }};">
      <div class="kicker">
        <span class="kicker__act">Act {{ page.act_no }}</span> · {{ page.act_title }}
      </div>
      <div class="slide-body">
        <div class="slide-body__copy">
          <h2 class="headline">{{ page.headline }}</h2>
          <div class="headline-rule"></div>
          {% if page.visible_text %}<p class="visible-text">{{ page.visible_text }}</p>{% endif %}
          {% if page.sources %}
          <div class="chips">
            {% for src in page.sources %}<span class="chip">{{ src }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="vcard">
          <div class="vcard__label">{{ page.visual_label }}</div>
          {% if page.visual_metric %}
          <div class="vcard__metric">{{ page.visual_metric.value }}</div>
          {% if page.visual_metric.label %}
          <div class="vcard__metric-label">{{ page.visual_metric.label }}</div>
          {% endif %}
          {% elif page.visual_points %}
          <ul class="vcard__points">
            {% for point in page.visual_points %}<li>{{ point }}</li>{% endfor %}
          </ul>
          {% else %}
          <div class="vcard__motif" aria-hidden="true">
            <span style="background: {{ page.accent }};"></span>
            <span style="background: {{ page.accent_2 }};"></span>
            <span style="background: {{ accent_color_2 }};"></span>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="page__foot">
        <span>{{ title }}</span>
        <span>{{ page.slide_no }} / {{ total_slides }}</span>
      </div>
    </section>
    {% endif %}
    {% endfor %}
  </body>
</html>
