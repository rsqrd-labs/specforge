<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {# Trusted, codebase-owned template (T-255). ``body_html`` is pre-rendered
       from markdown and bleach-cleaned against a strict allow-list before it
       reaches this template, so it is marked |safe here. All other values are
       autoescaped. No remote assets or external fonts. #}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
    />
    <title>{{ title }} — Speaker Notes</title>
    <style>
      @page {
        size: A4;
        margin: 20mm 18mm 20mm 18mm;
        @bottom-right {
          content: "Page " counter(page) " of " counter(pages);
          font-family: "Helvetica", "Arial", sans-serif;
          font-size: 9pt;
          color: #64748b;
        }
      }
      body {
        font-family: "Helvetica", "Arial", sans-serif;
        font-size: 10.5pt;
        line-height: 1.55;
        color: #0f172a;
      }
      h1 { font-size: 20pt; }
      h2 { font-size: 15pt; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }
      h3 { font-size: 12.5pt; }
      ul, ol { margin: 0.5em 0 0.5em 1.4em; }
      li { margin: 0.2em 0; }
      code {
        font-family: "Menlo", "Consolas", "Courier New", monospace;
        font-size: 9.5pt;
        background: #f1f5f9;
        padding: 1px 4px;
        border-radius: 3px;
      }
      blockquote {
        border-left: 3px solid #6d28d9;
        margin: 0.6em 0;
        padding: 0.3em 0.9em;
        color: #475569;
      }
      .header {
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 2px solid #6d28d9;
      }
      .header .kicker {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 9pt;
        font-weight: 700;
        color: #6d28d9;
      }
      .header .squirrel-brand-mark {
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
      }
      .footer {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 18px;
        font-size: 8.5pt;
        color: #94a3b8;
      }
      .footer .squirrel-brand-mark {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="kicker">
        {% include "_brand_squirrel.svg.j2" %}
        <span>SpecForge Storyboard</span>
      </div>
      <h1>{{ title }} — Speaker Notes</h1>
    </div>
    {{ body_html | safe }}
    <div class="footer">
      {% include "_brand_squirrel.svg.j2" %}
      <span>Generated by SpecForge · {{ generated_at }}</span>
    </div>
  </body>
</html>
