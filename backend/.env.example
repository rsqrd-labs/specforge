# Database
DATABASE_URL=postgresql+asyncpg://placeholder_user:placeholder_pass@placeholder_host:5432/specforge
REDIS_URL=rediss://default:placeholder_pass@placeholder_host:6380

# Auth
JWT_PRIVATE_KEY="placeholder-private-key"
JWT_PUBLIC_KEY="placeholder-public-key"
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
FRONTEND_URL=http://localhost:5173

# LLM Providers
ANTHROPIC_API_KEY=placeholder-anthropic-api-key
OPENAI_API_KEY=placeholder-openai-api-key
GOOGLE_API_KEY=placeholder-google-api-key

# Security
ENCRYPTION_MASTER_KEY=placeholder-encryption-master-key
CSRF_SECRET=placeholder-csrf-secret

# GitHub OAuth App — leave blank to disable GitHub export integration.
# When blank, GET /auth/github returns 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Observability
METRICS_TOKEN=
SENTRY_DSN=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=

# LLM observability (optional)
# Leave LANGFUSE_SECRET_KEY blank to disable the Langfuse integration entirely.
# When blank, the Langfuse SDK is never imported and zero network traffic is
# sent to a Langfuse host. The application behaves identically with or without
# these variables configured.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_CACHE_TTL=300
# Required in production only when LANGFUSE_SECRET_KEY is set. Setting this to
# true acknowledges that prompts and model outputs may be sent to Langfuse after
# secret-shaped redaction.
LANGFUSE_CONTENT_CAPTURE_ACK=false

# Stripe Payments (Phase 18)
# Leave STRIPE_SECRET_KEY empty to disable the billing UI entirely.
# Use sk_test_* keys for development; sk_live_* keys for production ONLY.
# WARNING: production deployments with sk_test_* are rejected at startup by
#          validate_production_settings() — this is intentional.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_CENTS=900
STRIPE_CREDITS_PER_PURCHASE=200
STRIPE_CREDIT_VALIDITY_DAYS=30
# IMPORTANT: STRIPE_SUCCESS_URL must point to the /billing page (NOT /billing/success).
# T-238 registers /billing as the authenticated billing route.  The Billing component
# detects ?session_id= on that route and enters polling mode.
# There is no separate /billing/success route — if you set this to /billing/success,
# users will land on a 404 after paying.
STRIPE_SUCCESS_URL=http://localhost:5173/billing
STRIPE_CANCEL_URL=http://localhost:5173/billing

# App
ENVIRONMENT=development
MAX_ACTIVE_WORKSPACES_PER_USER=50
