{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specforge.local/schemas/provider.schema.json",
  "title": "ProviderCatalog",
  "type": "object",
  "required": ["providers"],
  "additionalProperties": false,
  "properties": {
    "providers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "models", "judge_model"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["anthropic", "openai", "google"] },
          "name": { "type": "string", "minLength": 1 },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "judge_model": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
