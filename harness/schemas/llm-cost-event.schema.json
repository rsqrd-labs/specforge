{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thought2build.local/schemas/llm-cost-event.schema.json",
  "title": "Provider-normalized LLM cost event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "user_id",
    "stage_type",
    "operation",
    "provider",
    "model",
    "model_tier",
    "prompt_version",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "usage_estimation_method",
    "estimated_cost_usd",
    "latency_ms"
  ],
  "properties": {
    "workspace_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "stage_type": {
      "type": "string",
      "enum": ["spec", "plan", "harness", "tasks", "summary", "eval"]
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
    },
    "provider": {
      "type": "string",
      "enum": ["openai", "anthropic", "google"]
    },
    "model": { "type": "string", "minLength": 1 },
    "model_tier": {
      "type": "string",
      "enum": ["strong", "mid", "mini", "small", "judge", "embedding"]
    },
    "prompt_version": { "type": "string", "minLength": 1 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "provider_usage_raw": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "usage_estimation_method": {
      "type": "string",
      "enum": ["provider_reported", "tokenizer_estimated", "unknown"]
    },
    "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "cache_hit": { "type": "boolean" },
    "batch": { "type": "boolean" },
    "cross_provider_fallback": { "type": "boolean" }
  }
}
